# .env.prod.template — Production environment configuration template (REQ-005)
#
# INSTRUCTIONS:
#   1. Copy this file to .env.prod:  cp .env.prod.template .env.prod
#   2. Generate all secrets using the commands shown below
#   3. Fill in all placeholder values marked with <...>
#   4. NEVER commit .env.prod to version control (.gitignore covers .env*)
#
# Secret generation commands (run each one and paste the output):
#   JWT_SECRET:          openssl rand -hex 32
#   JWT_REFRESH_SECRET:  openssl rand -hex 32
#   CREDS_KEY:           openssl rand -hex 32
#   CREDS_IV:            openssl rand -hex 16
#   MEILI_MASTER_KEY:    openssl rand -hex 32
#   MONGO_ADMIN_PASSWORD: openssl rand -hex 32
#   POSTGRES_PASSWORD:   openssl rand -hex 32
#   MINIO_ROOT_PASSWORD: openssl rand -hex 32

#=====================================================================#
#                    Server Configuration                              #
#=====================================================================#

# REQ-009: Production mode — enables Secure + SameSite cookie flags
# WARNING: Setting this invalidates all active sessions. Plan as maintenance window.
NODE_ENV=production

HOST=0.0.0.0
PORT=3080

# REQ-010: CORS restriction to production domain
DOMAIN_CLIENT=https://chat.memodo-eng.de
DOMAIN_SERVER=https://chat.memodo-eng.de

# Proxy trust depth — matches single Caddy hop (REQ-049)
TRUST_PROXY=1
NO_INDEX=true
ADMIN_ENABLED=true

#=====================================================================#
#                    Authentication Secrets (REQ-005)                   #
#=====================================================================#
# Generate with: openssl rand -hex 32

JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>
CREDS_KEY=<generate-with-openssl-rand-hex-32>
CREDS_IV=<generate-with-openssl-rand-hex-16>

#=====================================================================#
#                    Registration Restriction (REQ-011, REQ-012)        #
#=====================================================================#
# Domain allowlist is configured in librechat.yaml (registration.allowedDomains)

ALLOW_REGISTRATION=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=false

#=====================================================================#
#                    MongoDB Configuration (REQ-006)                    #
#=====================================================================#
# scripts/mongodb-auth-migration.sh reads all four values below from .env.prod.
# - MONGO_ADMIN_USER/PASSWORD: root credentials (health checks, backups, exporter)
# - LIBRECHAT_MONGO_USER/PASSWORD: app credentials (used by the API)
# - MONGO_URI: must embed LIBRECHAT_MONGO_USER and LIBRECHAT_MONGO_PASSWORD;
#   the migration script verifies this and warns on drift.

MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=<generate-with-openssl-rand-hex-32>
LIBRECHAT_MONGO_USER=librechat
LIBRECHAT_MONGO_PASSWORD=<generate-with-openssl-rand-hex-32>
MONGO_URI=mongodb://<same-as-LIBRECHAT_MONGO_USER>:<same-as-LIBRECHAT_MONGO_PASSWORD>@mongodb:27017/LibreChat?authSource=LibreChat

# Connection pool tuning (optional — defaults are usually fine)
# MONGO_MAX_POOL_SIZE=
# MONGO_MIN_POOL_SIZE=

#=====================================================================#
#                    PostgreSQL Configuration (REQ-007)                 #
#=====================================================================#

POSTGRES_DB=librechat_rag
POSTGRES_USER=librechat_rag
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-32>

# RAG API database connection (must match PostgreSQL credentials above)
RAG_PORT=8000
DB_HOST=vectordb

#=====================================================================#
#                    MinIO / S3 Configuration (REQ-008)                 #
#=====================================================================#

MINIO_ROOT_USER=librechat-minio
MINIO_ROOT_PASSWORD=<generate-with-openssl-rand-hex-32>

#=====================================================================#
#                    MeiliSearch Configuration                         #
#=====================================================================#
# Generate with: openssl rand -hex 32

MEILI_MASTER_KEY=<generate-with-openssl-rand-hex-32>

#=====================================================================#
#                    Logging Configuration (REQ-014)                    #
#=====================================================================#

DEBUG_LOGGING=false
LOG_LEVEL=warn
CONSOLE_JSON=true
DEBUG_CONSOLE=false

#=====================================================================#
#                    Rate Limiting (REQ-036)                            #
#=====================================================================#

LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2
LIMIT_MESSAGE_IP=true
MESSAGE_IP_MAX=40
MESSAGE_IP_WINDOW=1

# Login rate limiting
LOGIN_MAX=7
LOGIN_WINDOW=5
REGISTER_MAX=5
REGISTER_WINDOW=60

#=====================================================================#
#                    Ban System (REQ-038)                               #
#=====================================================================#

BAN_VIOLATIONS=true
BAN_DURATION=7200000
BAN_INTERVAL=20

#=====================================================================#
#                    PII Detection (REQ-040, REQ-041)                   #
#=====================================================================#
# Start in warn mode to audit false positives before switching to block

PII_DETECTION=true
PII_DETECTION_API_URL=http://redakt-api:8000
PII_DETECTION_MODE=warn
PII_DETECTION_FAIL_OPEN=true
PII_DETECTION_TIMEOUT=2000
PII_DETECTION_SCORE_THRESHOLD=0.7
PII_DETECTION_EXEMPT_ROLES=admin

#=====================================================================#
#                    Endpoints                                         #
#=====================================================================#

ENDPOINTS=azureOpenAI,custom,agents

#=====================================================================#
#                    Azure OpenAI                                      #
#=====================================================================#
# Copy your Azure API key from .env

AZURE_OPENAI_API_KEY_SWEDEN=<copy-from-env>

#=====================================================================#
#                    Other API Keys                                    #
#=====================================================================#
# Copy from .env as needed

RESEARCH_AGENT_API_KEY=<copy-from-env>
SERPER_API_KEY=<copy-from-env>

#=====================================================================#
#                    User/Group IDs                                    #
#=====================================================================#

UID=501
GID=20

#=====================================================================#
#                    Backup Alerting (REQ-025)                         #
#=====================================================================#
# Webhook URL for backup failure notifications (Slack, Teams, etc.)
# If empty, backup failures are logged to stdout only.

BACKUP_WEBHOOK_URL=
# MAILTO for cron failure alerts (REQ-050)
# BACKUP_MAILTO=admin@memodo.de

#=====================================================================#
#                    Off-Host Backup (REQ-023)                         #
#=====================================================================#
# Mode: rsync or s3. Leave empty to skip off-host backup.
OFF_HOST_MODE=
# For rsync: user@host:/path/to/backups (requires SSH key-based auth)
OFF_HOST_RSYNC_TARGET=
# For s3: s3://bucket-name (requires AWS CLI credentials)
OFF_HOST_S3_BUCKET=

#=====================================================================#
#                    Monitoring (REQ-028)                               #
#=====================================================================#

# Grafana admin password — generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=<generate-with-openssl-rand-hex-16>

# MongoDB exporter URI — must include auth credentials after REQ-006
MONGO_EXPORTER_URI=mongodb://<admin-user>:<admin-password>@mongodb:27017

# Docker Compose project network name — used by monitoring stack to reach app containers
# This is typically <directory-name>_default. Check with: docker network ls
COMPOSE_PROJECT_NETWORK=librechat_default
