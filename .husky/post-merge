#!/bin/sh
[ -n "$CI" ] && exit 0

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║  Post-merge: Running PII detection verification...  ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""

# ── Phase 0: Static structural checks (fast, no build/test) ──────────
echo "▶ Phase 0: Static structural checks (scripts/pii-merge-verify.sh)..."
sh scripts/pii-merge-verify.sh
STATIC_EXIT=$?

if [ $STATIC_EXIT -ne 0 ]; then
  echo ""
  echo "┌──────────────────────────────────────────────────────┐"
  echo "│  ✗ PHASE 0 STATIC CHECKS FAILED                     │"
  echo "│                                                      │"
  echo "│  The merge shifted or removed PII customization      │"
  echo "│  hooks. Fix the failures listed above before running │"
  echo "│  tests. See docs/pii-merge-checklist.md sections 2   │"
  echo "│  and 4 for resolution guidance.                      │"
  echo "└──────────────────────────────────────────────────────┘"
  echo ""
  exit 1
fi

echo "  ✓ Phase 0 passed (static structural checks)"
echo ""

# ── Phase 1: Quick verification (unit + integration tests) ──────────
echo "▶ Phase 1: Unit + integration tests..."
cd api && npx jest --testPathPatterns="detectPII|pii-middleware" --no-coverage --silent 2>&1
UNIT_EXIT=$?
cd ..

if [ $UNIT_EXIT -ne 0 ]; then
  echo ""
  echo "┌──────────────────────────────────────────────────────┐"
  echo "│  ✗ PII TESTS FAILED                                 │"
  echo "│                                                      │"
  echo "│  The merge may have broken the PII detection         │"
  echo "│  middleware chain. Run the tests with verbose         │"
  echo "│  output to see what failed:                          │"
  echo "│                                                      │"
  echo "│  cd api && npx jest --testPathPatterns=\\              │"
  echo "│    \"detectPII|pii-middleware\" --no-coverage           │"
  echo "│                                                      │"
  echo "│  See docs/pii-merge-checklist.md for guidance.       │"
  echo "└──────────────────────────────────────────────────────┘"
  echo ""
  exit 1
fi

echo "  ✓ Phase 1 passed (unit + integration tests)"
echo ""

# ── Phase 2: E2E tests (if stack is running) ────────────────────────
echo "▶ Phase 2: Checking if full stack is available for e2e tests..."

# Check if LibreChat is running
LIBRECHAT_UP=false
if curl -sf http://localhost:3080 > /dev/null 2>&1; then
  LIBRECHAT_UP=true
fi

# Check if redakt is running
REDAKT_UP=false
if curl -sf http://localhost:8000/api/health > /dev/null 2>&1; then
  REDAKT_UP=true
fi

# If LibreChat is not running, skip all e2e tests (Phases 2 and 3)
if [ "$LIBRECHAT_UP" = false ]; then
  echo ""
  echo "┌──────────────────────────────────────────────────────┐"
  echo "│  ⚠ E2E tests skipped — LibreChat not running        │"
  echo "│                                                      │"
  echo "│  ✗ LibreChat not reachable at localhost:3080         │"
  echo "│                                                      │"
  echo "│  To run e2e tests manually:                          │"
  echo "│    1. Start the full stack (docker compose up -d)    │"
  echo "│    2. Run the test suites (see below)                │"
  echo "└──────────────────────────────────────────────────────┘"
  echo ""
  exit 0
fi

echo "  ✓ LibreChat running at localhost:3080"

# Phase 2 requires redakt; Phase 3 does NOT
PHASE2_SKIP=false
if [ "$REDAKT_UP" = false ]; then
  echo "  ⚠ Redakt not reachable — Phase 2 (PII e2e) will be skipped"
  PHASE2_SKIP=true
else
  echo "  ✓ Redakt running at localhost:8000"
fi

echo ""

# Check if storageState.json exists (auth state for Playwright)
if [ ! -f "e2e/storageState.json" ]; then
  echo ""
  echo "┌──────────────────────────────────────────────────────┐"
  echo "│  ⚠ E2E tests skipped — auth state not configured    │"
  echo "│                                                      │"
  echo "│  To set up e2e tests:                                │"
  echo "│    1. Set E2E_USER_EMAIL and E2E_USER_PASSWORD       │"
  echo "│       in your .env file                              │"
  echo "│    2. Run: npx playwright test \\                      │"
  echo "│       --config e2e/post-merge.playwright.config.ts   │"
  echo "│       (global setup will create storageState.json)   │"
  echo "│                                                      │"
  echo "│  After initial setup, the hook will run e2e tests    │"
  echo "│  automatically on future merges.                     │"
  echo "└──────────────────────────────────────────────────────┘"
  echo ""
  exit 0
fi

# ── Phase 2: PII e2e tests (requires redakt) ─────────────────────
if [ "$PHASE2_SKIP" = false ]; then
  echo "  Running Phase 2: PII Playwright e2e tests..."
  E2E_OUTPUT=$(npx playwright test e2e/specs/pii-detection.spec.ts --config e2e/pii.playwright.config.ts 2>&1)
  E2E_EXIT=$?

  if [ $E2E_EXIT -ne 0 ] && echo "$E2E_OUTPUT" | grep -q "Executable doesn't exist\|npx playwright install"; then
    echo ""
    echo "┌──────────────────────────────────────────────────────┐"
    echo "│  ⚠ E2E tests skipped — Playwright browsers missing  │"
    echo "│                                                      │"
    echo "│  Install browsers: npx playwright install            │"
    echo "└──────────────────────────────────────────────────────┘"
    echo ""
    exit 0
  fi

  echo "$E2E_OUTPUT"

  if [ $E2E_EXIT -ne 0 ]; then
    echo ""
    echo "┌──────────────────────────────────────────────────────┐"
    echo "│  ✗ PHASE 2 E2E TESTS FAILED                         │"
    echo "│                                                      │"
    echo "│  The merge may have broken PII detection in the UI.  │"
    echo "│  Run with headed mode to debug:                      │"
    echo "│                                                      │"
    echo "│  npx playwright test e2e/specs/pii-detection \\       │"
    echo "│    --headed                                          │"
    echo "│                                                      │"
    echo "│  See docs/pii-merge-checklist.md for guidance.       │"
    echo "└──────────────────────────────────────────────────────┘"
    echo ""
    exit 1
  fi

  echo "  ✓ Phase 2 passed (PII e2e tests)"
  echo ""
else
  echo "  ⏭ Phase 2 skipped (redakt not available)"
  echo ""
fi

# ── Phase 3: Post-merge e2e tests (custom features) ───────────────
# Phase 3 is INDEPENDENT of redakt. It tests dashboard, auth, routes,
# and package integrity. Only individual PII tests within this suite
# that need redakt will skip via test.skip().
echo "▶ Phase 3: Post-merge e2e tests (custom feature verification)..."
# Prerequisites (LibreChat running + storageState) already verified above.

echo "  Running post-merge e2e tests..."
PM_OUTPUT=$(npx playwright test --config e2e/post-merge.playwright.config.ts 2>&1)
PM_EXIT=$?

if [ $PM_EXIT -ne 0 ] && echo "$PM_OUTPUT" | grep -q "Executable doesn't exist\|npx playwright install"; then
  echo ""
  echo "┌──────────────────────────────────────────────────────┐"
  echo "│  ⚠ Phase 3 skipped — Playwright browsers missing    │"
  echo "│                                                      │"
  echo "│  Install browsers: npx playwright install            │"
  echo "└──────────────────────────────────────────────────────┘"
  echo ""
  exit 0
fi

echo "$PM_OUTPUT"

if [ $PM_EXIT -ne 0 ]; then
  echo ""
  echo "┌──────────────────────────────────────────────────────┐"
  echo "│  ✗ POST-MERGE E2E TESTS FAILED                      │"
  echo "│                                                      │"
  echo "│  The merge may have broken custom MemodoAI features. │"
  echo "│  Run with headed mode to debug:                      │"
  echo "│                                                      │"
  echo "│  npx playwright test \\                                │"
  echo "│    --config e2e/post-merge.playwright.config.ts \\     │"
  echo "│    --headed                                          │"
  echo "│                                                      │"
  echo "│  The merge is already committed. To recover:         │"
  echo "│    1. Fix the failing tests and commit the fix, OR   │"
  echo "│    2. Revert the merge: git revert HEAD              │"
  echo "│  See docs/pii-merge-checklist.md for guidance.       │"
  echo "└──────────────────────────────────────────────────────┘"
  echo ""
  exit 1
fi

echo ""
echo "┌──────────────────────────────────────────────────────┐"
echo "│  ✓ All post-merge tests passed                       │"
echo "│    Phase 0: Static structural checks                 │"
echo "│    Phase 1: Unit + integration tests                 │"
if [ "$PHASE2_SKIP" = false ]; then
echo "│    Phase 2: PII Playwright e2e tests                 │"
else
echo "│    Phase 2: Skipped (redakt unavailable)             │"
fi
echo "│    Phase 3: Post-merge e2e tests                     │"
echo "└──────────────────────────────────────────────────────┘"
echo ""
