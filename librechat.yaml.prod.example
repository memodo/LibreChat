# librechat.yaml.prod.example — Production-ready configuration template
#
# This file demonstrates the production configuration sections required by SPEC-010.
# Copy to librechat.yaml and adjust values for your deployment.
#
# Key differences from development librechat.yaml:
#   - REQ-011: Registration restricted to company email domains
#   - REQ-036: Rate limiting tuned for production
#   - REQ-037: Token balance system enabled
#   - REQ-038: Ban system enabled (configured via .env.prod)
#   - REQ-040: PII detection configured (warn mode)
#   - REQ-052: SSRF protection defaults verified

version: 1.3.6

cache: true

# REQ-011: Registration restricted to company email domains
# Combined with ALLOW_UNVERIFIED_EMAIL_LOGIN=false in .env.prod (REQ-012),
# this ensures only verified company emails can register.
registration:
  allowedDomains:
    - "memodo.de"
    - "memodo-eng.de"

interface:
  customWelcome: 'Welcome to MemodoAI'
  fileSearch: true
  endpointsMenu: true
  modelSelect: true
  parameters: true
  sidePanel: true
  presets: true
  prompts:
    use: true
    create: true
    share: true
    public: false
  bookmarks: true
  multiConvo: false
  agents:
    use: true
    create: true
    share: true
    public: false
  peoplePicker:
    users: true
    groups: true
    roles: true
  marketplace:
    use: false
  fileCitations: true

fileConfig:
  endpoints:
    azureOpenAI:
      fileLimit: 5
      fileSizeLimit: 20
      supportedMimeTypes:
        - "image/.*"
        - "application/pdf"
        - "text/.*"
        - "application/vnd.openxmlformats-officedocument.*"

# REQ-036: Rate limiting tuned for production
# These are application-level rate limits. .env.prod also sets:
#   LIMIT_CONCURRENT_MESSAGES=true, CONCURRENT_MESSAGE_MAX=2
#   LIMIT_MESSAGE_IP=true, MESSAGE_IP_MAX=40, MESSAGE_IP_WINDOW=1
#   LOGIN_MAX=7, LOGIN_WINDOW=5, REGISTER_MAX=5, REGISTER_WINDOW=60
rateLimits:
  fileUploads:
    ipMax: 100
    ipWindowInMinutes: 60
    userMax: 50
    userWindowInMinutes: 60
  conversationsImport:
    ipMax: 100
    ipWindowInMinutes: 60
    userMax: 50
    userWindowInMinutes: 60

transactions:
  enabled: true

# REQ-037: Token balance system for per-user cost control
# startBalance: initial tokens for new users (20,000 ~ 10 conversations)
# autoRefill: monthly refill of 10,000 tokens
balance:
  enabled: true
  startBalance: 20000
  autoRefillEnabled: true
  refillIntervalValue: 30
  refillIntervalUnit: 'days'
  refillAmount: 10000

# REQ-052: SSRF protection — verify defaults are active
# LibreChat blocks localhost, private IPs, .internal/.local TLDs by default.
# Add domains here only if agents/MCP need to reach specific internal services.
actions:
  allowedDomains: []

mcpSettings:
  allowedDomains: []

webSearch:
  searchProvider: serper
  scraperProvider: serper
  serperApiKey: '${SERPER_API_KEY}'

fileStrategy: "s3"

endpoints:
  agents:
    recursionLimit: 25
    maxRecursionLimit: 100
    disableBuilder: false
    maxCitations: 30
    maxCitationsPerFile: 7
    minRelevanceScore: 0.45
    titleModel: "gpt-5-mini"
    titleEndpoint: "azureOpenAI"
    capabilities: ["deferred_tools", "execute_code", "file_search", "web_search", "actions", "tools", "artifacts"]
  azureOpenAI:
    titleModel: "gpt-5-mini"
    plugins: true
    titleConvo: true
    summarize: true
    summaryModel: "gpt-5-mini"
    groups:
      - group: "sweden-central"
        apiKey: "${AZURE_OPENAI_API_KEY_SWEDEN}"
        instanceName: "memodo-openai-sweden"
        version: "2025-04-01-preview"
        models:
          gpt-5:
            deploymentName: "gpt-5"
          gpt-5-mini:
            deploymentName: "gpt-5-mini"

  custom:
    - name: "TA Research Agent"
      apiKey: "${RESEARCH_AGENT_API_KEY}"
      baseURL: "http://ta-agent-api:8000/v1"
      models:
        default: ["TA Research Agent v1"]
        fetch: false
      titleConvo: true
      titleEndpoint: "together.ai"
      titleModel: "meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo"
      summarize: true
      summaryModel: "meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo"
      streamRate: 25
      modelDisplayLabel: "TA Research Agent v1"

memory:
  disabled: false
  personalize: true
  tokenLimit: 10000
  agent:
    provider: "azureOpenAI"
    model: "gpt-5-mini"
    instructions: "You are a memory management assistant. Store and manage user information accurately."
    model_parameters:
      temperature: 0.1

modelSpecs:
  enforce: true
  addedEndpoints:
    - "custom"
    - "agents"
  list:
    - name: "gpt-5"
      label: "GPT-5"
      description: "GPT-5 with document upload support"
      group: "MemodoAI"
      groupIcon: "azureOpenAI"
      preset:
        endpoint: "azureOpenAI"
        model: "gpt-5"
        useResponsesApi: true
    - name: "TA Research Agent v1"
      label: "TA Research Agent"
      description: "Multi-stage talent acquisition news analysis pipeline"
      group: "MemodoAI"
      preset:
        endpoint: "TA Research Agent"
        model: "TA Research Agent v1"
