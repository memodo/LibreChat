# .env.test — test-environment app-config overrides for chat-test.memodo.de
#
# SAFE TO COMMIT: contains NO secrets. Layered onto the clone's .env.prod via
# docker-compose.test.yml (`env_file`). Only the keys below are overridden; all
# secrets, DB/MinIO/MEILI creds, Azure/Entra credentials, and PII settings are
# inherited from the clone's .env.prod (mounted at /app/.env + --env-file).
#
# dotenv is non-override, so these container-env values win over the same keys
# in the mounted .env.prod.

# Test subdomain (overrides the clone's prod domain)
DOMAIN_CLIENT=https://chat-test.memodo.de
DOMAIN_SERVER=https://chat-test.memodo.de

# Local email/password login instead of Entra SSO
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# Disable Entra/OpenID SSO: empty client id => the OpenID strategy is not
# initialized, so there is no broken redirect to an unregistered chat-test URI.
# OPENID_CLIENT_ID=  # 2026-07-08 commented to enable Entra SSO on test (inherit real id from .env.prod)
OPENID_AUTO_REDIRECT=false

# Relax auth rate limits for testing convenience
LOGIN_MAX=50
REGISTER_MAX=50

# 2026-07-08: OBO requires an app-audience access token (aud = the app's API),
# obtained only by requesting the custom API scope below. Present in local .env
# but missing from .env.prod; without it the SSO login yields only an id_token and
# OBO fails (AADSTS240002 for M365, AADSTS50013 for Entra group sync / People Search).
OPENID_SCOPE=openid profile email offline_access api://chat.memodo.de/323c5939-9fcf-4868-87e0-290a000be67c/access_as_user


# 2026-07-09 fix: neutralize legacy single-instance Azure env vars. Under v0.8.7
# the OpenAI SDK auto-reads these in the agent/tool completion path and overrides
# the librechat.yaml azureOpenAI group (Sweden) -> tool-bearing agents 401 against
# the Switzerland (RAG/embeddings) endpoint. yaml groups are the source of truth.
# RAG uses RAG_* vars and is unaffected (separate container, no .env.test).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# 2026-07-09 align to local working config: OBO userinfo flow (local .env has these;
# box .env.prod had FOR_USERINFO_REQUIRED empty + scope lowercase). Prod needs these too.
OPENID_ON_BEHALF_FLOW_FOR_USERINFO_REQUIRED=true
OPENID_ON_BEHALF_FLOW_USERINFO_SCOPE=User.Read
